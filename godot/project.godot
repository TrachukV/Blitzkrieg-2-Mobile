; Engine configuration file.
; Edit with Godot 4.7 or newer.

config_version=5

[application]

config/name="Blitzkrieg 2 Presentation Spike"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]

camera_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
camera_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
camera_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
camera_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
